# ============================================================
# Clinic Platform — Environment Variables
# ============================================================
# For local development, copy this file to `.env` and fill in real values.
# For Vercel production, set these in the project's Environment Variables tab.
# - VITE_* variables are exposed to the browser (client-safe).
# - All others are SERVER ONLY — never prefix with VITE_ and never commit.
# ============================================================

# --- Gemini AI (optional, server-side) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Public app URL (no trailing slash). Used for OAuth/CORS hints. ---
APP_URL="https://your-vercel-domain.vercel.app"

# ============================================================
# Firebase Client SDK (PUBLIC — safe in the browser)
# ============================================================
VITE_FIREBASE_API_KEY="AIzaSyDKGh6b1MFe1FLaT71Eq1z9wIPN6_4kyTI"
VITE_FIREBASE_AUTH_DOMAIN="hossammansourweb-9489f.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="hossammansourweb-9489f"
VITE_FIREBASE_STORAGE_BUCKET="hossammansourweb-9489f.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="180761581589"
VITE_FIREBASE_APP_ID="1:180761581589:web:56b2e57377c9db6559d61c"

# ============================================================
# Firebase Admin SDK (SERVER ONLY — used by /api routes)
# ============================================================
# In Vercel, set ONE of the following (base64 is recommended — no newlines):
#   FIREBASE_SERVICE_ACCOUNT_B64  -> base64 of the service-account JSON file
#   FIREBASE_SERVICE_ACCOUNT      -> raw JSON string
# To encode the JSON file:
#   base64 -w 0 path/to/service-account.json
# Or in Node:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('svc.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_B64=""
# FIREBASE_SERVICE_ACCOUNT=""
# FIREBASE_SERVICE_ACCOUNT_PATH="./hossammansourweb-9489f-firebase-adminsdk-fbsvc-1b0dbe2bbd.json"

# ============================================================
# Image hosting proxy (SERVER ONLY)
# ============================================================
# Used by the /api/patient/prescriptions upload proxy. Tries ImgBB first,
# then falls back to FreeImage.Host if ImgBB fails.
IMG_BB_API_KEY="4928381d580067cef94fe8759d7cf536"
FREE_IMAGE_API_KEY="6d207e02198a847aa98d0a2a901485a5"

# ============================================================
# Telegram notifications for NEW bookings (SERVER ONLY)
# ============================================================
# Sent from the backend only AFTER a booking is saved to Firestore.
# Never prefixed with VITE_ and never exposed to the browser.
# Get the token from @BotFather. The chat id is the target
# conversation/group id that should receive new-booking alerts.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
